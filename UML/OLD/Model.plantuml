@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

interface Action << interface >> {
  + getPriority(): int
  + execute(): List<BattleStatus>
}
class Battle {
  + Battle(): 
  - pokemonFactories: List<PokemonFactory>
  - humanPlayer: HumanPlayer
  - battleCount: int
  - currentBotPlayer: BotPlayer
  - botPlayerFactory: PlayerFactory
  + getBattleCount(): int
  + getHumanPlayer(): HumanPlayer
  + humanStarts(Action, Action): boolean
  + newBotPlayer(): void
  - initializePokemonFactories(): List<PokemonFactory>
  + resetBattleCount(): void
  + setBattleCount(int): void
  + executeBattle(Action): List<BattleStatus>
  + botLost(): boolean
  + getCurrentBotPlayer(): BotPlayer
  - setPokemonFactoryWithProbability(): void
  + humanLost(): boolean
}
enum BattleStatus << enumeration >> {
  + BattleStatus(): 
  + CONTINUE_WITH_BOT_CHANGE_POKEMON: 
  + NO_LEVEL_UP: 
  + CONTINUE_DAMAGE_TO_BOT_POKEMON: 
  + NO_EVOLVE: 
  + YOU_LOST: 
  + EVOLVE: 
  + YOU_WIN: 
  + NO_LEARN_MOVE: 
  + CONTINUE_WITH_NO_DAMAGE: 
  + CHANGE_YOUR_FAINTED_POKEMON: 
  + CHANGE_BOT_FAINTED_POKEMON: 
  + CHANGE_MOVE: 
  + CONTINUE_DAMAGE_TO_YOUR_POKEMON: 
  + YES_LEVEL_UP: 
  + CONTINUE_WITH_YOUR_CHANGE_POKEMON: 
  + LEARN_MOVE: 
  + values(): BattleStatus[]
  + valueOf(String): BattleStatus
}
class BotPlayer {
  + BotPlayer(String, Pokemon): 
  + smartPokemonChange(): void
  + smartPokemonMove(): Move
}
class BotPlayerFactory {
  + BotPlayerFactory(PokemonFactory): 
  - random: Random
  + createPlayer(): BotPlayer
}
class Breed {
  + Breed(String, Set<Type>, int, Breed, String, int, int, int, int, int, int, int, HashMap<Integer, String>): 
  - defBaseStat: int
  - evAmountDropped: int
  - evTypeDropped: String
  - specialAtkBaseStat: int
