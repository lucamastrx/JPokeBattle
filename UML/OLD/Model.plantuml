  + getSpecialAtkBaseStat(): int
  + getSpecialDefBaseStat(): int
  + getID(): String
  + getAtkBaseStat(): int
  + getTotalBaseStat(): int
  + hashCode(): int
  + getName(): String
  + getHpBaseStat(): int
  + getMoves(): HashMap<Integer, String>
  + getEvTypeDropped(): String
  + getEvoThreshold(): int
  + getEvAmountDropped(): int
  - setTypes(Set<Type>): void
  + getSuccessor(): Breed
  + getDefBaseStat(): int
  + toString(): String
  + getTypes(): HashSet<Type>
  + getSpeedBaseStat(): int
}
class EVDrop {
  + EVDrop(String, int): 
  - evAmountDropped: int
  - evTypeDropped: String
  + getEvTypeDropped(): String
