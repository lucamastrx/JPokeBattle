interface Saveable<V> << interface >> {
  + delete(String, V): void
  + save(): void
  + save(String, V): void
}
class SwitchPokemonAction {
  + SwitchPokemonAction(Player, Pokemon, Battle): 
  - actor: Player
  - battle: Battle
  - substitutePokemon: Pokemon
  + execute(): List<BattleStatus>
  + getPriority(): int
}
class Team<T> {
  + Team(T): 
  - activePokemon: T
  - pokemonList: List<T>
  + healAllPokemon(): void
