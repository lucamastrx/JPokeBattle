}
enum Type << enumeration >> {
  + Type(): 
  + FLYING: 
  + GRASS: 
  + ICE: 
  + DARK: 
  + DRAGON: 
  + GROUND: 
  + GHOST: 
  + PSYCHIC: 
  + WATER: 
  + POISON: 
  + ROCK: 
  + NORMAL: 
  + FIGHTING: 
  + BUG: 
  + STEEL: 
  + FIRE: 
  + ELECTRIC: 
  + values(): Type[]
  + valueOf(String): Type
}
class TypeEffectiveness {
  - TypeEffectiveness(): 
  - instance: TypeEffectiveness
  - effectivenessMap: Map<Type, Map<Type, Double>>
  + getEffectiveness(Type, Set<Type>): double
  - getEffectiveness(Type, Type): double
  + getInstance(): TypeEffectiveness
}

Battle                                -[#595959,dashed]->  BotPlayer                            : "«create»"
Battle                               "1" *-[#595959,plain]-> "currentBotPlayer\n1" BotPlayer                            
Battle                                -[#595959,dashed]->  BotPlayerFactory                     : "«create»"
Battle                                -[#595959,dashed]->  HighLevelPokemonFactory              : "«create»"
Battle                               "1" *-[#595959,plain]-> "humanPlayer\n1" HumanPlayer                          
Battle                               "1" *-[#595959,plain]-> "botPlayerFactory\n1" PlayerFactory                        
Battle                                -[#595959,dashed]->  Pokemon                              : "«create»"
Battle                               "1" *-[#595959,plain]-> "pokemonFactories\n*" PokemonFactory                       
Battle                                -[#595959,dashed]->  RandomPokemonFactory                 : "«create»"
Battle                                -[#595959,dashed]->  SameAverageLevelRandomPokemonFactory : "«create»"
BotPlayer                             -[#000082,plain]-^  Player                               
BotPlayerFactory                      -[#595959,dashed]->  BotPlayer                            : "«create»"
BotPlayerFactory                      -[#000082,plain]-^  PlayerFactory                        
Breed                                 -[#008200,dashed]-^  Identifiable                         
Breed                                "1" *-[#595959,plain]-> "types\n*" Type                                 
HighLevelPokemonFactory               -[#595959,dashed]->  Pokemon                              : "«create»"
HighLevelPokemonFactory               -[#000082,plain]-^  PokemonFactory                       
HumanPlayer                           -[#595959,dashed]->  OwnedPokemon                         : "«create»"
HumanPlayer                           -[#000082,plain]-^  Player                               
Move                                  -[#008200,dashed]-^  Identifiable                         
Move                                 "1" *-[#595959,plain]-> "type\n1" Type                                 
MoveAction                            -[#008200,dashed]-^  Action                               
MoveAction                           "1" *-[#595959,plain]-> "battle\n1" Battle                               
MoveAction                           "1" *-[#595959,plain]-> "move\n1" Move                                 
MoveAction                           "1" *-[#595959,plain]-> "actor\n1" Player                               
OwnedPokemon                          -[#008200,dashed]-^  Identifiable                         
OwnedPokemon                          -[#000082,plain]-^  Pokemon                              
OwnedPokemon                          -[#008200,dashed]-^  Saveable                             
Player                                -[#595959,dashed]->  Pokemon                              
Player                                -[#595959,dashed]->  Team                                 : "«create»"
Player                               "1" *-[#595959,plain]-> "team\n1" Team                                 
PlayerFactory                        "1" *-[#595959,plain]-> "pokemonFactory\n1" PokemonFactory                       
Pokemon                              "1" *-[#595959,plain]-> "breed\n1" Breed                                
Pokemon                               -[#595959,dashed]->  EVDrop                               : "«create»"
Pokemon                              "1" *-[#595959,plain]-> "moves\n*" Move                                 
RandomPokemonFactory                  -[#595959,dashed]->  Pokemon                              : "«create»"
RandomPokemonFactory                  -[#000082,plain]-^  PokemonFactory                       
SameAverageLevelRandomPokemonFactory  -[#595959,dashed]->  Pokemon                              : "«create»"
SameAverageLevelRandomPokemonFactory  -[#000082,plain]-^  PokemonFactory                       
Saveable                              -[#595959,dashed]->  Identifiable                         
SwitchPokemonAction                   -[#008200,dashed]-^  Action                               
SwitchPokemonAction                  "1" *-[#595959,plain]-> "battle\n1" Battle                               
SwitchPokemonAction                  "1" *-[#595959,plain]-> "actor\n1" Player                               
SwitchPokemonAction                  "1" *-[#595959,plain]-> "substitutePokemon\n1" Pokemon                              
Team                                  -[#595959,dashed]->  Pokemon                              
TypeEffectiveness                    "1" *-[#595959,plain]-> "effectivenessMap\n*" Type                                 
@enduml
